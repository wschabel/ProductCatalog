@model List<ProductCatalog.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<a asp-controller="Products" asp-action="Create">
    Add New Product
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("c")</td>
                <td>
                    <a asp-controller="Products"
                    asp-action="Details"
                    asp-route-id="@product.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
